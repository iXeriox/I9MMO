+  {
+    id: 'rising_wayfinder',
+    title: 'Rising Wayfinder',
+    giver: 'Archivist Kade',
+    description: 'Reach level 5. Growth is its own signal.',
+    type: 'level',
+    filter: null,
+    target: 5,
+    minLevel: 1,
+    requires: [],
