# Port the HTTPS (or HTTP fallback) server listens on
PORT=8443

# TLS certificate + key. If both files exist, the server starts with wss:// enabled.
# If unset, the server falls back to plain HTTP/WS for local development.
SSL_KEY_PATH=./certs/dev-key.pem
SSL_CERT_PATH=./certs/dev-cert.pem
# Optional CA bundle, needed for some CA-issued (non-self-signed) certs
# SSL_CA_PATH=./certs/ca-bundle.pem
